  "mocks_teste_gas": {
    "calcularPermissoesAutomaticas_cargo_gestor": {
      "input": {
        "origem": { "cargo": "gestor", "funcoes": [], "setores": ["producao"], "donos_espaco": [] },
        "perfil_base": "gestor"
      },
      "expected_visualizar": ["agenda", "estrategia", "comunicacao", "espacos", "reservas", "contratos", "relatorios", "eficiencia", "tarefas", "processos"]
    },
    "calcularPermissoesAutomaticas_cargo_rh": {
      "input": {
        "origem": { "cargo": "rh", "funcoes": [], "setores": [], "donos_espaco": [] },
        "perfil_base": "rh"
      },
      "expected_visualizar": ["agenda", "estrategia", "comunicacao", "espacos", "financeiro", "tarefas", "rh", "eficiencia", "contratacoes", "relatorios", "escuta", "pessoal"],
      "expected_NOT_visualizar": ["reservas", "contratos", "processos", "almoxarifado", "balcao"]
    },
    "calcularPermissoesAutomaticas_admin_tecnico_bloqueio_sensiveis": {
      "input": {
        "origem": { "cargo": "admin_tecnico", "funcoes": [], "setores": [], "donos_espaco": [] },
        "perfil_base": "admin"
      },
      "expected_NOT_visualizar": ["rh", "contratacoes", "financeiro"]
    },
