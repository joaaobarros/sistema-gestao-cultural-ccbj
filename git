<!--
@file permissoes_admin_ui_js.html
@layer frontend/ui
@description Interface simplificada de gestão de permissões (V2) integrada à aba Configurações.
             Lista usuários do sistema e permite editar permissões manuais.
@responsibility Renderizar lista de usuários, carregar permissões e salvar alterações.
@dependencies GAS.admin.obterEmailsSistema, GAS.permissoes.obterV2, GAS.permissoes.salvarV2
-->

<script>

/**
 * ========================================
 * BLOCO: Estado local do módulo
 * ========================================
 * @description Armazena o usuário atualmente selecionado para edição.
 */
let _usuarioAtual = null;


/**
 * ========================================
 * BLOCO: Carregar lista de usuários
 * ========================================
 * @description Busca lista de emails únicos do sistema e renderiza na UI.
 * @context Disparado pelo botão "Atualizar" na aba Configurações.
 * @dependencies GAS.admin.obterEmailsSistema
 */
function carregarUsuariosPermissoes() {

  GAS.admin.obterEmailsSistema(function(lista) {

    const el = document.getElementById('listaUsuariosPermissoes');
    if (!el) return;

    el.innerHTML = '';

    lista.forEach(function(email) {

      const div = document.createElement('div');
      div.className = "p-2 text-xs cursor-pointer hover:bg-slate-100 rounded";
      div.innerText = email;

      div.onclick = function() {
        selecionarUsuarioPermissoes(email);
      };

      el.appendChild(div);

    });

  });

}


/**
 * ========================================
 * BLOCO: Selecionar usuário
 * ========================================
 * @description Define usuário ativo e carrega suas permissões via backend V2.
 * @param email string — email do usuário selecionado
 * @dependencies GAS.permissoes.obterV2
 */
function selecionarUsuarioPermissoes(email) {

  _usuarioAtual = email;

  GAS.permissoes.obterV2(email, function(data) {

    renderEditorPermissoes(email, data);

  });

}


/**
 * ========================================
 * BLOCO: Render do editor
 * ========================================
 * @description Renderiza UI básica de edição para o usuário selecionado.
 *              (versão inicial — pode evoluir para granularidade completa)
 * @param email string
 * @param data object — retorno de obterPermissoesUsuarioV2
 */
function renderEditorPermissoes(email, data) {

  const el = document.getElementById('editorPermissoes');
  if (!el) return;

  el.innerHTML = `
    <div class="text-sm font-bold mb-2">${email}</div>

    <p class="text-xs text-slate-400 mb-4">
      Edição simplificada de permissões (modo inicial).
    </p>

    <button onclick="salvarPermissoesUsuarioAtual()"
      class="bg-green-600 text-white px-4 py-2 text-xs rounded-xl">
      Salvar permissões
    </button>
  `;

}


/**
 * ========================================
 * BLOCO: Salvar permissões
 * ========================================
 * @description Envia alterações para backend V2.
 *              Atualmente salva estrutura vazia (base para evolução).
 * @dependencies GAS.permissoes.salvarV2
 */
function salvarPermissoesUsuarioAtual() {

  if (!_usuarioAtual) return;

  GAS.permissoes.salvarV2({
    email: _usuarioAtual,
    permissoes_manuais: {}
  }, function() {

    Swal.fire('Salvo', 'Permissões atualizadas', 'success');

  });

}

</script>